{
  "stage": "A",
  "questions": "datos/preguntas_recuperacion_dev.jsonl",
  "encoders": {
    "lexical": {"type": "hashing_bow"},
    "mbert": {"type": "mean_pooling", "model": "google-bert/bert-base-multilingual-cased"},
    "beto": {"type": "mean_pooling", "model": "dccuchile/bert-base-spanish-wwm-cased"},
    "minilm": {"type": "sentence_transformer", "model": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"},
    "e5small": {"type": "sentence_transformer", "model": "intfloat/multilingual-e5-small", "query_prefix": "query: ", "passage_prefix": "passage: "},
    "e5base": {"type": "sentence_transformer", "model": "intfloat/multilingual-e5-base", "query_prefix": "query: ", "passage_prefix": "passage: "},
    "e5large": {"type": "sentence_transformer", "model": "intfloat/multilingual-e5-large", "query_prefix": "query: ", "passage_prefix": "passage: "},
    "bgem3": {"type": "sentence_transformer", "model": "BAAI/bge-m3"}
  },
  "chunkings": {"section700meta": {"strategy": "section", "max_chars": 700, "metadata": true}},
  "selections": {"k1": {"top_k": 1}, "k3": {"top_k": 3}}
}
